{
  "name": "foco-editor",
  "private": true,
  "version": "1.0.6",
  "description": "FOCO Editor — editor de vídeo com IA",
  "productName": "FOCO Editor",
  "author": "FOCO Marketing",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:ai": "node scripts/e2e-ai.mjs",
    "test:e2e:fx": "node scripts/e2e-fx.mjs",
    "test:e2e:chat": "node scripts/e2e-chat.mjs",
    "test:e2e:phase1": "node scripts/e2e-phase1.mjs",
    "test:e2e:phase2": "node scripts/e2e-phase2.mjs",
    "test:load": "node scripts/load.mjs t1,t2,t3,t4,t5,t6,t7",
    "app:run": "node scripts/build-desktop.mjs --run",
    "app:build": "node scripts/build-desktop.mjs",
    "test:e2e:desktop": "node scripts/build-desktop.mjs --no-web --prepare && node scripts/e2e-desktop.mjs",
    "build:web": "vite build",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@huggingface/transformers": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "mediabunny": "^1.61.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.7.0": true
  },
  "build": {
    "appId": "com.focomarketing.editor",
    "productName": "FOCO Editor",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "focomarketing",
        "repo": "foco-editor",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "local-server/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FOCO Editor",
      "deleteAppDataOnUninstall": false,
      "artifactName": "FOCO-Editor-Setup-${version}.${ext}"
    }
  }
}
