{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professional-video-editor/color-decision",
  "title": "Decisão de cor (saída de autocolor.py auto)",
  "type": "object",
  "required": ["profile", "confidence", "intensity", "adjustments", "lut", "protections", "no_change"],
  "properties": {
    "profile": { "type": "string", "enum": ["professional-natural", "talking-head-cinematic", "podcast-clean", "youtube-professional", "social-clean", "documentary"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Intensidade do look do perfil (padrão 0.15–0.35)." },
    "applied_factor": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fator aplicado à decisão após a validação (1 = integral; menor = reduzido automaticamente)." },
    "intensity_effective": { "type": "number" },
    "issues": { "type": "array", "items": { "type": "string" }, "description": "Problemas técnicos medidos no original. Vazio = original bom." },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "adjustments": {
      "type": "object",
      "description": "ColorSettings do FOCO Editor (sem 'preset').",
      "additionalProperties": false,
      "required": ["exposure", "contrast", "highlights", "shadows", "saturation", "vibrance", "temperature", "tint", "vignette"],
      "properties": {
        "exposure": { "type": "number", "minimum": -2, "maximum": 2 },
        "contrast": { "type": "number", "minimum": -1, "maximum": 1 },
        "highlights": { "type": "number", "minimum": -1, "maximum": 1 },
        "shadows": { "type": "number", "minimum": -1, "maximum": 1 },
        "saturation": { "type": "number", "minimum": -1, "maximum": 1 },
        "vibrance": { "type": "number", "minimum": -1, "maximum": 1 },
        "temperature": { "type": "number", "minimum": -1, "maximum": 1 },
        "tint": { "type": "number", "minimum": -1, "maximum": 1 },
        "vignette": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "unsupported": { "type": "object", "description": "Controles pedidos pelo padrão mas ainda inexistentes no motor (whites, blacks, sharpen, noise_reduction, hsl_green, lut).", "additionalProperties": { "type": "null" } },
    "lut": { "type": ["string", "null"] },
    "lut_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "protections": {
      "type": "object",
      "properties": { "skin": { "type": "boolean" }, "shadows": { "type": "boolean" }, "highlights": { "type": "boolean" }, "saturation": { "type": "boolean" } }
    },
    "no_change": { "type": "boolean" },
    "note": { "type": "string" },
    "attempts": { "type": "array", "items": { "type": "object" } },
    "metrics_median": { "type": "object" }
  }
}
